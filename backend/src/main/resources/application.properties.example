# MySQL Configuration
spring.datasource.url=jdbc:mysql://localhost:3306/EVENTMANAGEMENT?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
spring.datasource.username=YOUR_USERNAME
spring.datasource.password=YOUR_PASSWORD

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true

# Server Configuration
server.port=7070

# JWT Configuration
jwt.secret=YOUR_JWT_SECRET_KEY_MINIMUM_256_BITS_FOR_HS256_ALGORITHM
jwt.expiration=86400000

# CORS Configuration
spring.web.cors.allowed-origins=http://localhost:5500,http://127.0.0.1:5500,http://localhost:7070,http://127.0.0.1:7070,http://localhost:9090,http://127.0.0.1:9090,http://localhost:5173,http://127.0.0.1:5173
spring.web.cors.allowed-methods=GET,POST,PUT,DELETE,OPTIONS
spring.web.cors.allowed-headers=*
spring.web.cors.allow-credentials=true

# AI LLM Configuration (Google Gemini / OpenRouter / OpenAI)
openai.api.key=${OPENAI_API_KEY:${OPENROUTER_API_KEY:}}
openai.api.url=${OPENAI_API_URL:https://generativelanguage.googleapis.com/v1beta/openai/chat/completions}
openai.model=${OPENAI_MODEL:gemini-2.0-flash}
openai.connect.timeout.ms=5000
openai.read.timeout.ms=10000

# Semantic Embedding Configuration (Google Gemini / OpenRouter / OpenAI)
embedding.provider=${EMBEDDING_PROVIDER:gemini}
embedding.model=${EMBEDDING_MODEL:models/embedding-001}
embedding.api.url=${EMBEDDING_API_URL:https://generativelanguage.googleapis.com/v1beta}
embedding.api.key=${EMBEDDING_API_KEY:${openai.api.key:}}
embedding.connect.timeout.ms=5000
embedding.read.timeout.ms=10000

# Persistent Vector Cache Directory (survives mvn clean)
rag.vector.cache.dir=${RAG_VECTOR_CACHE_DIR:data/vector-cache}

# Hybrid Scoring & Entity Boosting Weights
rag.hybrid.lexical.weight=${RAG_HYBRID_LEXICAL_WEIGHT:0.4}
rag.hybrid.semantic.weight=${RAG_HYBRID_SEMANTIC_WEIGHT:0.6}
rag.hybrid.entity.boost=${RAG_HYBRID_ENTITY_BOOST:0.35}
